                class="px-3 py-1.5 rounded-lg bg-white border border-slate-300 text-xs font-semibold text-slate-700 hover:bg-slate-100 cursor-pointer"
              >
                Escenario Planilla (100% cobrado)
              </button>
              <button
                onclick="presetSimulador(0, 0, 0)"
                class="px-3 py-1.5 rounded-lg bg-white border border-slate-300 text-xs font-semibold text-slate-700 hover:bg-slate-100 cursor-pointer"
              >
                Escenario Conservador (Solo saldo hoy)
              </button>
            </div>
          </div>

          <!-- Resultado en vivo del simulador -->
          <div class="lg:col-span-5 bg-slate-900 text-white p-6 rounded-2xl space-y-4">
            <h4 class="font-display font-bold text-base text-emerald-300 uppercase tracking-wider">Resultado Simulado</h4>
            
            <div class="space-y-2.5 text-sm">
              <div class="flex justify-between text-slate-300">
                <span>Saldo Libre Base Actual:</span>
                <span class="font-semibold text-white tabular-nums">$ 358.410</span>
              </div>
              <div class="flex justify-between text-emerald-300">
                <span>(+) Cobros pendientes simulados:</span>
                <span id="sim-cobros" class="font-semibold tabular-nums">+ $ 80.000</span>
              </div>
              <div class="flex justify-between text-rose-300">
                <span>(−) Presupuesto Regalo Profesora:</span>
                <span id="sim-prof" class="font-semibold tabular-nums">− $ 0</span>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-700">
              <p class="text-xs uppercase tracking-wider text-slate-400">Saldo Final Disponible para Regalos</p>
              <p id="sim-total" class="font-display text-3xl sm:text-4xl font-extrabold text-amber-400 mt-1 tabular-nums">$ 438.410</p>
              <p id="sim-mensaje" class="text-xs text-slate-300 mt-2">
                Con el 100% de los cobros al día y sin descontar aún el regalo de la profesora, este es el monto exacto proyectado en la planilla.
              </p>
            </div>
          </div>

        </div>
      </div>
    </div>

  </main>

  <!-- Pie de página -->
  <footer class="bg-white border-t border-slate-200 mt-10 py-5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-slate-500">
      <p>Rendición de Cuentas y Balance del Curso • Portal Informativo para Apoderados</p>
      <p>Valores verificados según planilla oficial de tesorería</p>
    </div>
  </footer>

  <!-- JavaScript para Gráficos Interactivos, Pestañas, Buscador y Simulador -->
  <script>
    // Formateador de moneda chilena con punto como separador de miles
    function formatCLP(valor) {
      const signo = valor < 0 ? '- ' : '';
      const absVal = Math.abs(Math.round(valor));
      return signo + '$ ' + absVal.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
    }

    // Cambio de pestañas
    function cambiarTab(tab) {
      const tabs = ['visual', 'detalle', 'simulador'];
      tabs.forEach(t => {
        const panel = document.getElementById('panel-' + t);
        const btn = document.getElementById('tab-btn-' + t);
        if (t === tab) {
          panel.classList.remove('hidden');
          btn.classList.remove('text-slate-600', 'hover:text-slate-900', 'hover:bg-slate-100');
          btn.classList.add('bg-slate-900', 'text-white', 'shadow-sm');
        } else {
          panel.classList.add('hidden');
          btn.classList.remove('bg-slate-900', 'text-white', 'shadow-sm');
          btn.classList.add('text-slate-600', 'hover:text-slate-900', 'hover:bg-slate-100');
        }
      });
    }

    // Filtro de búsqueda en tablas
    function filtrarTablas(texto) {
      const query = texto.toLowerCase().trim();
      const filas = document.querySelectorAll('.fila-buscable');
      filas.forEach(fila => {
        const contenido = fila.textContent.toLowerCase();
        fila.style.display = contenido.includes(query) ? '' : 'none';
      });
    }

    // Copiar resumen ejecutivo para WhatsApp
    function copiarResumenTexto() {
      const texto = [
        '📊 *RENDICIÓN DE CUENTAS Y BALANCE DEL CURSO*',
        '',
        '✅ *Total Ingresos Recaudados:* $ 1.219.700',
        '   • Cuotas: $ 620.000',
        '   • Otros ingresos (sopaipillas, rifas, bingo, cuadro extra): $ 379.700',
        '   • Cuadros: $ 220.000',
        '',
        '💸 *Total Gastos Ejecutados:* $ 241.790',
        '💰 *Saldo Actual en Caja:* $ 977.910',
        '',
        '📌 *Compromisos por Pagar:* $ 619.500',
        '   • Cuadros: $ 312.000',
        '   • Casa de cumpleaños: $ 250.000',
        '   • Birretes: $ 57.500',
        '',
        '🟢 *Saldo Libre Actual:* $ 358.410',
        '⏳ *Pendiente por Cobrar:* $ 80.000 ($ 70.000 cuotas + $ 10.000 cuadros)',
        '🎁 *Proyección Final para Regalos (si pagan todos):* $ 438.410'
      ].join('\n');

      const textarea = document.createElement('textarea');
      textarea.value = texto;
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      try {
        document.execCommand('copy');
        const toast = document.getElementById('toast-copiado');
        toast.classList.remove('hidden');
        setTimeout(() => toast.classList.add('hidden'), 4500);
      } catch (err) {
        console.error('No se pudo copiar el texto', err);
      }
      document.body.removeChild(textarea);
    }

    // Simulador de proyección
    function actualizarSimulador() {
      const cuotas = parseInt(document.getElementById('slider-cuotas').value, 10);
      const cuadros = parseInt(document.getElementById('slider-cuadros').value, 10);
      const profesora = parseInt(document.getElementById('slider-profesora').value, 10);

      document.getElementById('val-cuotas').textContent = formatCLP(cuotas);
      document.getElementById('val-cuadros').textContent = formatCLP(cuadros);
      document.getElementById('val-profesora').textContent = formatCLP(profesora);

      const cobrosExtra = cuotas + cuadros;
      const saldoBase = 358410;
      const totalSimulado = saldoBase + cobrosExtra - profesora;

      document.getElementById('sim-cobros').textContent = '+ ' + formatCLP(cobrosExtra);
      document.getElementById('sim-prof').textContent = '− ' + formatCLP(profesora);
      document.getElementById('sim-total').textContent = formatCLP(totalSimulado);

      const msgEl = document.getElementById('sim-mensaje');
      if (cuotas === 70000 && cuadros === 10000 && profesora === 0) {
        msgEl.textContent = 'Con el 100% de los cobros al día y sin descontar aún el regalo de la profesora, este es el monto exacto proyectado en la planilla.';
      } else {
        msgEl.textContent = `Recaudando ${formatCLP(cobrosExtra)} adicionales y asignando ${formatCLP(profesora)} al regalo de la profesora, quedarían ${formatCLP(totalSimulado)} disponibles.`;
      }
    }

    function presetSimulador(cuotas, cuadros, profesora) {
      document.getElementById('slider-cuotas').value = cuotas;
      document.getElementById('slider-cuadros').value = cuadros;
      document.getElementById('slider-profesora').value = profesora;
      actualizarSimulador();
    }

    // Inicialización de Gráficos con Chart.js al cargar la página
    window.addEventListener('DOMContentLoaded', () => {
      Chart.defaults.font.family = "'Inter', sans-serif";
      Chart.defaults.color = '#475569';

      // GRÁFICO 1: Flujo Financiero General (Barras)
      const ctxFlujo = document.getElementById('chartFlujo').getContext('2d');
      new Chart(ctxFlujo, {
        type: 'bar',
        data: {
          labels: [
            'Total Ingresos',
            'Gastos Pagados',
            'Saldo en Caja',
            'Pagos Pendientes',
            'Saldo Libre',
            'Proy. Regalos'
          ],
          datasets: [{
            label: 'Monto (CLP)',
            data: [1219700, 241790, 977910, 619500, 358410, 438410],
            backgroundColor: [
              '#059669', // Verde esmeralda - Total Ingresos
              '#e11d48', // Coral/Rojo - Gastos Pagados
              '#0284c7', // Azul - Saldo en Caja
              '#f59e0b', // Ámbar - Pagos Pendientes
              '#065f46', // Verde oscuro - Saldo Libre Actual
              '#d97706'  // Ámbar dorado - Proyección Regalos
            ],
            borderRadius: 8,
            borderSkipped: false,
            barPercentage: 0.62
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#0f172a',
              padding: 12,
              cornerRadius: 10,
              callbacks: {
                label: (ctx) => ' ' + formatCLP(ctx.parsed.y)
              }
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              grid: { color: '#f1f5f9' },
              ticks: {
                callback: (value) => '$ ' + (value / 1000) + 'k'
              }
            },
            x: {
              grid: { display: false },
              ticks: {
                font: { size: 11, weight: '600' }
              }
            }
          }
        }
      });

      // GRÁFICO 2: Composición de los Ingresos (Dona)
      const ctxIngresos = document.getElementById('chartIngresos').getContext('2d');
      new Chart(ctxIngresos, {
        type: 'doughnut',
        data: {
          labels: ['Cuotas (50,8%)', 'Otros Ingresos (31,1%)', 'Cuadros (18,0%)'],
          datasets: [{
            data: [620000, 379700, 220000],
            backgroundColor: ['#059669', '#0284c7', '#f59e0b'],
            borderWidth: 3,
            borderColor: '#ffffff',
            hoverOffset: 6
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '64%',
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#0f172a',
              padding: 12,
              cornerRadius: 10,
              callbacks: {
                label: (ctx) => {
                  const total = 1219700;
                  const pct = ((ctx.parsed / total) * 100).toFixed(1).replace('.', ',');
                  return ` ${formatCLP(ctx.parsed)} (${pct}%)`;
                }
              }
            }
          }
        }
      });

      // GRÁFICO 3: Estado de Avance de Compromisos Principales (Barras Horizontales Apiladas)
      const ctxCompromisos = document.getElementById('chartCompromisos').getContext('2d');
      new Chart(ctxCompromisos, {
        type: 'bar',
        data: {
          labels: ['Casa de Cumpleaños', 'Cuadros', 'Birretes'],
          datasets: [
            {
              label: 'Abonado',
              data: [100000, 0, 57500],
              backgroundColor: '#059669',
              borderRadius: 6,
              barPercentage: 0.55
            },
            {
              label: 'Pendiente por Pagar',
              data: [250000, 312000, 57500],
              backgroundColor: '#f59e0b',
              borderRadius: 6,
              barPercentage: 0.55
            }
          ]
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#0f172a',
              padding: 12,
              cornerRadius: 10,
              callbacks: {
                label: (ctx) => ` ${ctx.dataset.label}: ${formatCLP(ctx.parsed.x)}`
              }
            }
          },
          scales: {
            x: {
              stacked: true,
              grid: { color: '#f1f5f9' },
              ticks: {
                callback: (value) => '$ ' + (value / 1000) + 'k'
              }
            },
            y: {
              stacked: true,
              grid: { display: false },
              ticks: {
                font: { size: 12, weight: '600' },
                color: '#1e293b'
              }
            }
          }
        }
      });
    });
  </script>
</body>
</html>
